PROJECT_NAME="Event Scheduling & Project Invoice Management Engine"
API_V1_STR="/api"

# Default SQLite database (runs locally out of the box with zero setup)
DATABASE_URL="sqlite:///./event_engine.db"

# Or for PostgreSQL in Docker:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/event_engine_db"

# Or for MySQL in Docker:
# DATABASE_URL="mysql+pymysql://root:rootpassword@db:3306/event_engine_db"

DEFAULT_TIMEZONE="UTC"
